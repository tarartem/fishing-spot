{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpotRecommendationResponse",
  "type": "object",
  "required": [
    "water_body_summary",
    "restriction_overview",
    "recommended_spots"
  ],
  "properties": {
    "water_body_summary": {
      "type": "string",
      "description": "Brief overview of the water body characteristics for the chosen fishing style and target species."
    },
    "restriction_overview": {
      "type": "object",
      "required": ["overall_status", "warnings", "disclaimer"],
      "properties": {
        "overall_status": {
          "type": "string",
          "enum": ["allowed", "permit_required", "seasonal_restriction", "prohibited", "unknown"]
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Specific restricted grid cells or local rules the angler must respect."
        },
        "disclaimer": {
          "type": "string",
          "description": "Reminder to verify local fishing permits and seasonal regulations."
        }
      }
    },
    "recommended_spots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "cell_id",
          "coordinates",
          "title",
          "confidence_score",
          "why_this_spot",
          "tactical_advice",
          "target_species_fit",
          "restriction_status"
        ],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "cell_id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]{1,2}$",
            "description": "Grid cell identifier, e.g. C4"
          },
          "coordinates": {
            "type": "object",
            "required": ["latitude", "longitude"],
            "properties": {
              "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
            }
          },
          "title": {
            "type": "string",
            "description": "Short descriptive title for the spot on the map."
          },
          "confidence_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "why_this_spot": {
            "type": "string",
            "description": "Detailed explanation of why fish hold in this grid cell based on structure, depth, or shoreline features."
          },
          "tactical_advice": {
            "type": "object",
            "required": ["recommended_baits_or_lures", "presentation_tips", "best_time_of_day"],
            "properties": {
              "recommended_baits_or_lures": {
                "type": "array",
                "items": { "type": "string" }
              },
              "presentation_tips": { "type": "string" },
              "best_time_of_day": { "type": "string" }
            }
          },
          "target_species_fit": {
            "type": "array",
            "items": { "type": "string" }
          },
          "restriction_status": {
            "type": "string",
            "enum": ["allowed", "permit_required", "seasonal_restriction", "unknown"]
          }
        }
      }
    }
  }
}
