{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpotRecommendationResponse",
  "type": "object",
  "required": [
    "water_body_name",
    "region_label",
    "water_body_summary",
    "geographical_context",
    "restriction_check",
    "recommended_spots",
    "best_game_plan"
  ],
  "properties": {
    "water_body_name": {
      "type": "string",
      "description": "Recognized name of the water body."
    },
    "region_label": {
      "type": "string",
      "description": "Municipality, Autonomous Community, and country (Spain)."
    },
    "water_body_summary": {
      "type": "string",
      "description": "Overview of the water body, scale of analysis, and target species."
    },
    "geographical_context": {
      "type": "object",
      "required": [
        "water_elevation_m",
        "relief_range_m",
        "scale_label",
        "road_access_summary",
        "shore_accessibility_summary"
      ],
      "properties": {
        "water_elevation_m": { "type": "number" },
        "relief_range_m": { "type": "number" },
        "scale_label": { "type": "string" },
        "road_access_summary": { "type": "string" },
        "shore_accessibility_summary": { "type": "string" }
      }
    },
    "restriction_check": {
      "type": "object",
      "required": [
        "status",
        "status_label",
        "permits_required",
        "prohibited_zones_warning",
        "regulations_list",
        "verified_sources",
        "disclaimer"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["allowed", "permit_required", "seasonal_restriction", "prohibited"]
        },
        "status_label": { "type": "string" },
        "permits_required": { "type": "string" },
        "prohibited_zones_warning": { "type": "string" },
        "regulations_list": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verified_sources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "disclaimer": { "type": "string" }
      }
    },
    "recommended_spots": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "color",
          "cell_id",
          "grid_cells_label",
          "title",
          "x_percent",
          "y_percent",
          "why_label",
          "why_this_spot",
          "how_to_fish"
        ],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 6 },
          "color": { "type": "string", "enum": ["red", "blue", "orange"] },
          "cell_id": {
            "type": "string",
            "pattern": "^[A-H][1-8]$"
          },
          "grid_cells_label": {
            "type": "string"
          },
          "badge": {
            "type": "string"
          },
          "title": { "type": "string" },
          "x_percent": { "type": "number", "minimum": 2, "maximum": 98 },
          "y_percent": { "type": "number", "minimum": 2, "maximum": 98 },
          "why_label": { "type": "string" },
          "why_this_spot": { "type": "string" },
          "secondary_label": { "type": "string" },
          "secondary_text": { "type": "string" },
          "how_to_fish": { "type": "string" }
        }
      }
    },
    "best_game_plan": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": { "type": "string" }
    }
  }
}
