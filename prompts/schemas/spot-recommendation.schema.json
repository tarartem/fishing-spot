{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpotRecommendationResponse",
  "type": "object",
  "required": [
    "water_body_name",
    "region_label",
    "water_body_summary",
    "recommended_spots",
    "best_game_plan"
  ],
  "properties": {
    "water_body_name": {
      "type": "string",
      "description": "Recognized name of the water body."
    },
    "region_label": {
      "type": "string",
      "description": "Region and country of the water body."
    },
    "water_body_summary": {
      "type": "string",
      "description": "Brief overview of the water body and target species."
    },
    "recommended_spots": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "color",
          "cell_id",
          "grid_cells_label",
          "title",
          "x_percent",
          "y_percent",
          "why_label",
          "why_this_spot",
          "how_to_fish"
        ],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 6 },
          "color": { "type": "string", "enum": ["red", "blue", "orange"] },
          "cell_id": {
            "type": "string",
            "pattern": "^[A-H][1-8]$"
          },
          "grid_cells_label": {
            "type": "string",
            "description": "e.g. 'Grid E6 / F6' or 'Grid E4'"
          },
          "badge": {
            "type": "string",
            "description": "Optional trophy badge for top spots, e.g. '🏆 (The #1 Trophy Point)'"
          },
          "title": { "type": "string" },
          "x_percent": { "type": "number", "minimum": 2, "maximum": 98 },
          "y_percent": { "type": "number", "minimum": 2, "maximum": 98 },
          "why_label": {
            "type": "string",
            "description": "e.g. 'Why it\\'s #1:', 'Why it\\'s incredible:', or 'Why it\\'s great:'"
          },
          "why_this_spot": { "type": "string" },
          "secondary_label": {
            "type": "string",
            "description": "Optional e.g. 'The Terrain:' or 'Why fish love it:'"
          },
          "secondary_text": { "type": "string" },
          "how_to_fish": { "type": "string" }
        }
      }
    },
    "best_game_plan": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": { "type": "string" }
    }
  }
}
